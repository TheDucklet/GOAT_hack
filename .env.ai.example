AI_MODULE=app.ai.bridge
AI_GENERATION_VERSION=1
AI_LLM_BASE_URL=https://changellenge.up.railway.app/v1
AI_LLM_API_KEY=
AI_LLM_TIMEOUT_SECONDS=60
AI_LLM_MAX_RETRIES=2
AI_LLM_RETRY_BACKOFF_SECONDS=1
AI_LLM_TEMPERATURE=0.2
AI_LLM_USAGE_LOG_PATH=storage/ai-usage.jsonl
AI_LLM_BUDGET_LEDGER_PATH=storage/ai-budget.jsonl
AI_CACHE_DIR=storage/ai-cache/results
AI_CACHE_ENABLED=true
