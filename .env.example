# Local Docker Compose configuration. Copy to .env; defaults also allow a local smoke run.
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
POSTGRES_USER=goat
POSTGRES_DB=goat
POSTGRES_PASSWORD=goat-local-only
# For passwords with URI-special characters, override the URL with percent-encoded credentials.
# DATABASE_URL=postgresql+psycopg://goat:encoded-password@postgres:5432/goat
ENVIRONMENT=development
COOKIE_SECURE=false
SESSION_HOURS=24
DEMO_PASSWORD=Local-demo-password-2026
MAX_PDF_BYTES=52428800
NEWS_POLL_MINUTES=20
WORKER_POLL_SECONDS=2
JOB_TIMEOUT_SECONDS=900
# Bounded showcase; enable periodic live RSS collection explicitly after setup.
NEWS_COLLECTION_ENABLED=false
NEWS_MAX_NEW_PUBLICATIONS=5
FEED_CANDIDATE_LIMIT=10
FEED_PREPARE_TOP_K=2
# Optional server-only AI configuration; no key is needed for infrastructure checks.
AI_ENV_FILE=.env.ai
